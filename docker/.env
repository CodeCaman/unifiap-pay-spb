# UniFIAP Pay SPB - Configurações de Ambiente
# Este arquivo substitui scripts por configuração declarativa

# === CONFIGURAÇÕES DO PROJETO ===
COMPOSE_PROJECT_NAME=unifiap-pay-spb
VERSION=v1.93744
BUILD_DATE=2025-11-12
DOCKER_USER=renanafs

# === AMBIENTE ===
NODE_ENV=production
FLASK_ENV=production
LOG_LEVEL=info

# === PORTAS DOS SERVIÇOS ===
API_PORT=5000
FRONTEND_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CADVISOR_PORT=8081
NODE_EXPORTER_PORT=9100

# === CONFIGURAÇÕES DA API ===
RESERVA_BANCARIA_SALDO=1000000.00
API_RATE_LIMIT=100
API_TIMEOUT=30

# === CONFIGURAÇÕES DA AUDITORIA ===
LIQUIDATION_MODE=continuous
MONITORING_INTERVAL=30
BATCH_SIZE=100

# === CONFIGURAÇÕES DO BANCO DE DADOS ===
DB_HOST=postgres
DB_PORT=5432
DB_NAME=unifiapay
DB_USER=spb_user
DB_PASSWORD=spb_secure_2024

# === CONFIGURAÇÕES DE CACHE ===
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL=300

# === CONFIGURAÇÕES DE SEGURANÇA ===
JWT_SECRET=unifiap_jwt_secret_key_2024
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# === CONFIGURAÇÕES DO GRAFANA ===
GRAFANA_PASSWORD=admin123
GRAFANA_ADMIN_USER=admin

# === CONFIGURAÇÕES DO PROMETHEUS ===
PROMETHEUS_RETENTION=30d
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

# === CONFIGURAÇÕES DE ALERTAS ===
ALERT_MANAGER_SMTP_HOST=smtp.gmail.com
ALERT_MANAGER_SMTP_PORT=587
ALERT_MANAGER_RECEIVER_EMAIL=admin@unifiap.edu.br

# === CONFIGURAÇÕES DE MONITORAMENTO ===
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30s
LOG_RETENTION_DAYS=7

# === CONFIGURAÇÕES DE REDE ===
NETWORK_NAME=unifiap_net

# === CONFIGURAÇÕES DE RECURSOS ===
API_MEMORY_LIMIT=512m
API_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=128m
MONITORING_MEMORY_LIMIT=1g
