{
  "id": null,
  "title": "UniFIAP Pay SPB - Sistema de Pagamentos Instantâneos",
  "description": "Dashboard completo para monitoramento do Sistema de Pagamentos Brasileiro (SPB) - UniFIAP Pay",
  "tags": ["spb", "pix", "pagamentos", "fiap", "banking"],
  "style": "dark",
  "timezone": "America/Sao_Paulo",
  "editable": true,
  "hideControls": false,
  "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "refresh": "10s",
    "schemaVersion": 39,
    "version": 1,
    "panels": [
      {
        "id": 1,
        "title": "🏦 Status Geral do Sistema SPB",
        "type": "stat",
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.5},
                {"color": "green", "value": 1}
              ]
            },
            "custom": {
              "displayMode": "basic"
            }
          }
        },
        "targets": [
          {
            "expr": "up{job=\"api-pagamentos\"}",
            "legendFormat": "API Pagamentos",
            "refId": "A"
          },
          {
            "expr": "up{job=\"auditoria-service\"}",
            "legendFormat": "Auditoria Service",
            "refId": "B"
          },
          {
            "expr": "up{job=\"frontend-pix\"}",
            "legendFormat": "Frontend PIX",
            "refId": "C"
          }
        ]
      },
      {
        "id": 2,
        "title": "💰 Transações PIX em Tempo Real",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 20,
              "gradientMode": "hue",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "auto",
              "pointSize": 5,
              "stacking": {"mode": "none", "group": "A"},
              "axisPlacement": "auto",
              "axisLabel": "Transações/seg",
              "scaleDistribution": {"type": "linear"}
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "none"},
          "legend": {"displayMode": "visible", "placement": "bottom"}
        },
        "targets": [
          {
            "expr": "rate(flask_http_request_total{job=\"api-pagamentos\"}[1m])",
            "legendFormat": "Requests PIX/min",
            "refId": "A"
          },
          {
            "expr": "rate(flask_http_request_duration_seconds_count{job=\"api-pagamentos\"}[1m])",
            "legendFormat": "Transações Processadas/min",
            "refId": "B"
          }
        ]
      },
      {
        "id": 3,
        "title": "⏱️ Latência das Transações",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 20,
              "gradientMode": "hue",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "auto",
              "pointSize": 5,
              "stacking": {"mode": "none", "group": "A"},
              "axisPlacement": "auto",
              "axisLabel": "Latência (ms)",
              "scaleDistribution": {"type": "linear"}
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "none"},
          "legend": {"displayMode": "visible", "placement": "bottom"}
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(flask_http_request_duration_seconds_bucket{job=\"api-pagamentos\"}[5m])) * 1000",
            "legendFormat": "P50 Latência",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(flask_http_request_duration_seconds_bucket{job=\"api-pagamentos\"}[5m])) * 1000",
            "legendFormat": "P95 Latência",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(flask_http_request_duration_seconds_bucket{job=\"api-pagamentos\"}[5m])) * 1000",
            "legendFormat": "P99 Latência",
            "refId": "C"
          }
        ]
      },
      {
        "id": 4,
        "title": "🔧 Uso de CPU dos Microsserviços",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 20,
              "gradientMode": "hue",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "auto",
              "pointSize": 5,
              "stacking": {"mode": "none", "group": "A"},
              "axisPlacement": "auto",
              "axisLabel": "CPU %",
              "scaleDistribution": {"type": "linear"}
            },
            "max": 100
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "none"},
          "legend": {"displayMode": "visible", "placement": "bottom"}
        },
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{name=~\".*api-pagamentos.*\"}[5m]) * 100",
            "legendFormat": "API Pagamentos CPU",
            "refId": "A"
          },
          {
            "expr": "rate(container_cpu_usage_seconds_total{name=~\".*auditoria-service.*\"}[5m]) * 100",
            "legendFormat": "Auditoria Service CPU",
            "refId": "B"
          },
          {
            "expr": "rate(container_cpu_usage_seconds_total{name=~\".*frontend-pix.*\"}[5m]) * 100",
            "legendFormat": "Frontend PIX CPU",
            "refId": "C"
          }
        ]
      },
      {
        "id": 5,
        "title": "💾 Uso de Memória dos Microsserviços",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 20,
              "gradientMode": "hue",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "auto",
              "pointSize": 5,
              "stacking": {"mode": "none", "group": "A"},
              "axisPlacement": "auto",
              "axisLabel": "Memória",
              "scaleDistribution": {"type": "linear"}
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "none"},
          "legend": {"displayMode": "visible", "placement": "bottom"}
        },
        "targets": [
          {
            "expr": "container_memory_usage_bytes{name=~\".*api-pagamentos.*\"}",
            "legendFormat": "API Pagamentos RAM",
            "refId": "A"
          },
          {
            "expr": "container_memory_usage_bytes{name=~\".*auditoria-service.*\"}",
            "legendFormat": "Auditoria Service RAM",
            "refId": "B"
          },
          {
            "expr": "container_memory_usage_bytes{name=~\".*frontend-pix.*\"}",
            "legendFormat": "Frontend PIX RAM",
            "refId": "C"
          }
        ]
      },
      {
        "id": 6,
        "title": "🌐 Tráfego de Rede",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 20,
              "gradientMode": "hue",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "auto",
              "pointSize": 5,
              "stacking": {"mode": "none", "group": "A"},
              "axisPlacement": "auto",
              "axisLabel": "Bytes/seg",
              "scaleDistribution": {"type": "linear"}
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "none"},
          "legend": {"displayMode": "visible", "placement": "bottom"}
        },
        "targets": [
          {
            "expr": "rate(container_network_receive_bytes_total{name=~\".*api-pagamentos.*\"}[5m])",
            "legendFormat": "API RX",
            "refId": "A"
          },
          {
            "expr": "rate(container_network_transmit_bytes_total{name=~\".*api-pagamentos.*\"}[5m])",
            "legendFormat": "API TX",
            "refId": "B"
          },
          {
            "expr": "rate(container_network_receive_bytes_total{name=~\".*frontend-pix.*\"}[5m])",
            "legendFormat": "Frontend RX",
            "refId": "C"
          },
          {
            "expr": "rate(container_network_transmit_bytes_total{name=~\".*frontend-pix.*\"}[5m])",
            "legendFormat": "Frontend TX",
            "refId": "D"
          }
        ]
      },
      {
        "id": 7,
        "title": "📊 Status dos Containers",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            },
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        },
        "options": {
          "showHeader": true,
          "sortBy": [{"desc": false, "displayName": "Container"}]
        },
        "targets": [
          {
            "expr": "up",
            "format": "table",
            "instant": true,
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true},
              "indexByName": {},
              "renameByName": {
                "instance": "Endpoint",
                "job": "Serviço",
                "Value": "Status"
              }
            }
          }
        ]
      },
      {
        "id": 8,
        "title": "🏦 Reserva Bancária SPB",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 28},
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyBRL",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 500000},
                {"color": "green", "value": 1000000}
              ]
            },
            "custom": {
              "displayMode": "basic"
            }
          }
        },
        "targets": [
          {
            "expr": "unifiap_reserva_bancaria_saldo",
            "legendFormat": "Reserva Bancária",
            "refId": "A"
          }
        ]
      },
      {
        "id": 9,
        "title": "💸 Volume de Transações PIX (24h)",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 28},
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1000},
                {"color": "red", "value": 5000}
              ]
            },
            "custom": {
              "displayMode": "basic"
            }
          }
        },
        "targets": [
          {
            "expr": "increase(flask_http_request_total{job=\"api-pagamentos\"}[24h])",
            "legendFormat": "Transações 24h",
            "refId": "A"
          }
        ]
      },
      {
        "id": 10,
        "title": "⚡ Taxa de Erro SPB",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 16, "y": 28},
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            },
            "custom": {
              "displayMode": "basic"
            }
          }
        },
        "targets": [
          {
            "expr": "(rate(flask_http_request_total{status=~\"4..|5..\"}[5m]) / rate(flask_http_request_total[5m])) * 100",
            "legendFormat": "Taxa de Erro %",
            "refId": "A"
          }
        ]
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "links": [],
    "gnetId": null,
    "folderId": null,
    "overwrite": true
}